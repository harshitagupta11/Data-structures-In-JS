// Insert an element at the bottom of the stack

function insertAtBottom(element){
    let tempStack=[];
    while(stack.length>0){
        tempStack.push(stack.shift());
    }
    stack.push(element);
    while(tempStack.length>0){
        stack.push(tempStack.shift());
    }

}

let stack =[2,4,1,7,8];

insertAtBottom(6);
console.log(stack);